page {
  min-height: 100%;
  background:
    radial-gradient(circle at 50% -10%, rgba(52, 130, 255, 0.12), transparent 38%),
    linear-gradient(180deg, #ffffff 0%, #f7f7f7 46%, #f0f0f0 100%);
  color: #000000;
}

.app-page {
  min-height: 100vh;
  padding: 28rpx 24rpx 44rpx;
  box-sizing: border-box;
}

.glass-card {
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 38rpx rgba(0, 0, 0, 0.07);
}

.hero-card {
  padding: 34rpx 30rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 38rpx rgba(0, 0, 0, 0.07);
}

.hero-kicker {
  font-size: 22rpx;
  letter-spacing: 0;
  color: #8c93b0;
}

.hero-title {
  margin-top: 12rpx;
  font-size: 50rpx;
  font-weight: 700;
  color: #000000;
}

.hero-subtitle {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #666666;
}

.stat-row {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-top: 28rpx;
}

.stat-chip {
  flex: 1;
  min-width: 180rpx;
  padding: 20rpx 22rpx;
  border-radius: 28rpx;
  background: #f7f7f7;
  box-shadow: inset 0 0 0 1rpx #e8e8e8;
}

.stat-label {
  display: block;
  font-size: 22rpx;
  color: #8c93b0;
}

.stat-value {
  display: block;
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #000000;
}

.section-card {
  margin-top: 22rpx;
  padding: 28rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 38rpx rgba(0, 0, 0, 0.07);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.section-title {
  font-size: 34rpx;
  line-height: 1.35;
  font-weight: 700;
  color: #000000;
}

.section-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #8c93b0;
}

.badge-pill {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #3482ff;
  background: #eaf2ff;
}

.badge-pill.success {
  color: #0f766e;
  background: rgba(20, 184, 166, 0.14);
}

.badge-pill.warn {
  color: #b45309;
  background: rgba(245, 158, 11, 0.14);
}

.badge-pill.danger {
  color: #b42318;
  background: rgba(248, 113, 113, 0.14);
}

.data-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 22rpx;
}

.data-item {
  padding: 24rpx;
  border-radius: 28rpx;
  background: #f7f7f7;
  box-shadow: inset 0 0 0 1rpx #e8e8e8;
}

.data-item-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 18rpx;
}

.data-item-title {
  font-size: 32rpx;
  line-height: 1.4;
  font-weight: 700;
  color: #000000;
}

.data-item-subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8c93b0;
}

.data-item-value {
  font-size: 42rpx;
  line-height: 1;
  font-weight: 700;
  color: #000000;
}

.data-item-value.success {
  color: #15803d;
}

.data-item-value.danger {
  color: #dc2626;
}

.muted-text {
  font-size: 24rpx;
  line-height: 1.7;
  color: #8c93b0;
}

.loading-panel,
.error-panel,
.empty-state {
  margin-top: 40rpx;
  padding: 34rpx 24rpx;
  text-align: center;
  color: #8c93b0;
  font-size: 26rpx;
  border-radius: 28rpx;
  background: #ffffff;
}

.error-panel {
  color: #410002;
  background: #fdf6f4;
  box-shadow: inset 0 0 0 1rpx rgba(233, 70, 52, 0.18);
}

.action-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.action-btn {
  margin-top: 24rpx;
  border-radius: 999rpx !important;
  font-size: 28rpx !important;
}

.action-btn.primary {
  color: #fff !important;
  background: #3482ff !important;
}

.action-btn.secondary {
  color: #000000 !important;
  background: #f0f0f0 !important;
  border: 1rpx solid #e0e0e0 !important;
}
