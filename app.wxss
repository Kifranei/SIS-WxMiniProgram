page {
  min-height: 100%;
  background:
    radial-gradient(circle at top left, rgba(179, 229, 252, 0.45), transparent 34%),
    radial-gradient(circle at top right, rgba(255, 224, 178, 0.4), transparent 32%),
    linear-gradient(180deg, #f6f7fb 0%, #eef2f7 100%);
  color: #0f172a;
}

.app-page {
  min-height: 100vh;
  padding: 28rpx 24rpx 44rpx;
  box-sizing: border-box;
}

.glass-card {
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.86);
  box-shadow: 0 18rpx 42rpx rgba(15, 23, 42, 0.08);
  backdrop-filter: blur(18rpx);
}

.hero-card {
  padding: 34rpx 30rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 20rpx 50rpx rgba(15, 23, 42, 0.08);
  backdrop-filter: blur(18rpx);
}

.hero-kicker {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  color: #8c93a3;
}

.hero-title {
  margin-top: 12rpx;
  font-size: 54rpx;
  font-weight: 700;
  color: #111827;
}

.hero-subtitle {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #5f6675;
}

.stat-row {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-top: 28rpx;
}

.stat-chip {
  flex: 1;
  min-width: 180rpx;
  padding: 20rpx 22rpx;
  border-radius: 28rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f5f7fb 100%);
  box-shadow: inset 0 0 0 1rpx rgba(148, 163, 184, 0.14);
}

.stat-label {
  display: block;
  font-size: 22rpx;
  color: #7a8190;
}

.stat-value {
  display: block;
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
}

.section-card {
  margin-top: 22rpx;
  padding: 28rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 18rpx 42rpx rgba(15, 23, 42, 0.08);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.section-title {
  font-size: 34rpx;
  line-height: 1.35;
  font-weight: 700;
  color: #0f172a;
}

.section-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #7a8190;
}

.badge-pill {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #2563eb;
  background: rgba(37, 99, 235, 0.12);
}

.badge-pill.success {
  color: #0f766e;
  background: rgba(20, 184, 166, 0.14);
}

.badge-pill.warn {
  color: #b45309;
  background: rgba(245, 158, 11, 0.14);
}

.badge-pill.danger {
  color: #b42318;
  background: rgba(248, 113, 113, 0.14);
}

.data-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 22rpx;
}

.data-item {
  padding: 24rpx;
  border-radius: 28rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
  box-shadow: inset 0 0 0 1rpx rgba(148, 163, 184, 0.12);
}

.data-item-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 18rpx;
}

.data-item-title {
  font-size: 32rpx;
  line-height: 1.4;
  font-weight: 700;
  color: #0f172a;
}

.data-item-subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7a8190;
}

.data-item-value {
  font-size: 42rpx;
  line-height: 1;
  font-weight: 700;
  color: #111827;
}

.data-item-value.success {
  color: #15803d;
}

.data-item-value.danger {
  color: #dc2626;
}

.muted-text {
  font-size: 24rpx;
  line-height: 1.7;
  color: #667085;
}

.loading-panel,
.error-panel,
.empty-state {
  margin-top: 40rpx;
  padding: 34rpx 24rpx;
  text-align: center;
  color: #7a8190;
  font-size: 26rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.78);
}

.error-panel {
  color: #b42318;
  background: rgba(254, 242, 242, 0.92);
  box-shadow: inset 0 0 0 1rpx rgba(248, 113, 113, 0.16);
}

.action-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.action-btn {
  margin-top: 24rpx;
  border-radius: 999rpx !important;
  font-size: 28rpx !important;
}

.action-btn.primary {
  color: #fff !important;
  background: linear-gradient(135deg, #0a84ff 0%, #5ac8fa 100%) !important;
}

.action-btn.secondary {
  color: #0f172a !important;
  background: linear-gradient(180deg, #ffffff 0%, #f4f6fb 100%) !important;
  border: 1rpx solid rgba(148, 163, 184, 0.35) !important;
}
