<view class="app-page">
  <view class="hero-card">
    <view class="hero-kicker">Teaching Desk</view>
    <view class="hero-title">我教授的课程</view>
    <view class="hero-subtitle">查看授课课程、选课人数，并从课程列表进入学生成绩录入。</view>
  </view>

  <view wx:if="{{loading}}" class="loading-panel">正在加载授课数据...</view>

  <view wx:if="{{!loading && loadError}}" class="error-panel">{{loadError}}</view>

  <view wx:if="{{!loading && !loadError && courseList.length > 0}}" class="section-card">
    <view class="section-header">
      <view>
        <view class="section-title">课程列表</view>
        <view class="section-desc">选择课程后可进入学生名单并批量录入成绩</view>
      </view>
      <view class="badge-pill warn">{{courseList.length}} 门</view>
    </view>

    <view class="data-list">
      <block wx:for="{{courseList}}" wx:key="index">
        <view class="data-item course-item">
          <view class="data-item-header">
            <view>
              <view class="data-item-title">{{item.CourseName}}</view>
              <view class="data-item-subtitle">学分：{{item.Credits}}</view>
            </view>
            <view class="badge-pill course-type-badge">{{item.TypeText || ('类型 ' + item.Type)}}</view>
          </view>

          <view class="course-meta">
            <view class="course-meta-item">课程编号：{{item.CourseID}}</view>
            <view class="course-meta-item">选课人数：{{item.EnrolledStudentCount || 0}}</view>
          </view>

          <view class="course-actions">
            <button class="mini-action primary" bindtap="openGradeEntry" data-course-id="{{item.CourseID}}">录入成绩</button>
          </view>
        </view>
      </block>
    </view>
  </view>

  <view wx:if="{{!loading && !loadError && courseList.length === 0}}" class="empty-state">
    暂无授课记录
  </view>
</view>
