.timetable-page {
  padding-bottom: 36rpx;
}

.hero-divider {
  margin: 0 10rpx;
  color: #94a3b8;
}

.quick-btn {
  min-width: 136rpx;
  border-radius: 999rpx !important;
  border: 1rpx solid rgba(148, 163, 184, 0.24) !important;
  background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%) !important;
  color: #334155 !important;
  font-size: 24rpx !important;
}

.quick-btn-primary {
  color: #0a84ff !important;
  border-color: rgba(10, 132, 255, 0.22) !important;
}

.quick-btn-warn {
  color: #f59e0b !important;
  border-color: rgba(245, 158, 11, 0.24) !important;
}

.quick-btn-purple {
  color: #7c3aed !important;
  border-color: rgba(124, 58, 237, 0.24) !important;
}

.quick-btn-danger {
  color: #dc2626 !important;
  border-color: rgba(220, 38, 38, 0.22) !important;
}

.timetable-toolbar {
  padding: 22rpx 28rpx;
}

.week-navigation {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.nav-btn {
  min-width: 140rpx;
  text-align: center;
  padding: 14rpx 12rpx;
  font-size: 24rpx;
  color: #0a84ff;
  border-radius: 999rpx;
  background: rgba(10, 132, 255, 0.08);
}

.current-week {
  font-size: 34rpx;
  font-weight: 700;
  color: #0f172a;
}

.timetable-card {
  padding: 18rpx;
}

.timetable-swiper { width: 100%; height: 1100rpx; }
.timetable-scroll { height: 100%; }
.grid-container { display: grid; grid-template-columns: 80rpx repeat(7, 100rpx); grid-auto-rows: 80rpx; }
.grid-item { box-sizing: border-box; border-bottom: 1rpx solid #e5e7eb; border-right: 1rpx solid #e5e7eb; text-align: center; font-size: 22rpx; color: #64748b; display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,0.7); }
.day-header, .time-header { background-color: #f8fafc; font-weight: bold; color: #334155; }
.day-cell { position: relative; }
.course-block { position: absolute; top: 2rpx; left: 2rpx; right: 2rpx; background: linear-gradient(135deg, #0a84ff 0%, #5ac8fa 100%); color: white; border-radius: 12rpx; padding: 5rpx; box-sizing: border-box; font-size: 20rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; z-index: 1; overflow: hidden; box-shadow: 0 8rpx 20rpx rgba(10, 132, 255, 0.22); }
.modal-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.5); z-index: 1000; }
.modal-dialog { position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 80%; background-color: white; border-radius: 24rpx; z-index: 1001; overflow: hidden; }
.modal-title { padding: 30rpx; text-align: center; font-size: 32rpx; font-weight: bold; border-bottom: 1rpx solid #eee; }
.modal-content { padding: 30rpx; font-size: 28rpx; line-height: 1.8; }
.modal-content .label { font-weight: bold; color: #333; }
.modal-footer { padding: 20rpx; border-top: 1rpx solid #eee; text-align: center; }
.modal-btn { width: 100%; background: linear-gradient(135deg, #0a84ff 0%, #5ac8fa 100%); color: white; border-radius: 999rpx; }
