.stats-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 22rpx;
}

.metric-card {
  width: calc(50% - 10rpx);
  padding: 30rpx;
  border-radius: 28rpx;
  box-sizing: border-box;
  box-shadow: 0 18rpx 40rpx rgba(15, 23, 42, 0.08);
}

.metric-card.full {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.metric-card.users {
  background: linear-gradient(180deg, #eef6ff 0%, #dbeafe 100%);
}

.metric-card.students {
  background: linear-gradient(180deg, #edfdf3 0%, #dcfce7 100%);
}

.metric-card.teachers {
  background: linear-gradient(180deg, #fff6ea 0%, #ffedd5 100%);
}

.metric-card.courses {
  background: linear-gradient(180deg, #f7efff 0%, #ede9fe 100%);
}

.metric-card.classes {
  background: linear-gradient(180deg, #f8fafc 0%, #e2e8f0 100%);
}

.metric-label {
  font-size: 24rpx;
  color: #475467;
}

.metric-value {
  margin-top: 12rpx;
  font-size: 52rpx;
  font-weight: 700;
  color: #0f172a;
}

.metric-note {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #94a3b8;
}

.refresh-tip {
  margin-top: 28rpx;
  text-align: center;
  font-size: 24rpx;
  color: #94a3b8;
}
