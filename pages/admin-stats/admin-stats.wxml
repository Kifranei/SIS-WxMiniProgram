<view class="app-page">
  <view class="hero-card">
    <view class="hero-kicker">Admin Monitor</view>
    <view class="hero-title">系统运行状态</view>
    <view class="hero-subtitle">管理员移动端可查看当前系统的用户、学生、教师、课程与班级规模。</view>
  </view>

  <view wx:if="{{loading}}" class="loading-panel">数据加载中...</view>

  <view wx:if="{{!loading && stats}}" class="stats-grid">
    <view class="metric-card users">
      <view class="metric-label">注册用户</view>
      <view class="metric-value">{{stats.UserCount}}</view>
      <view class="metric-note">Total Users</view>
    </view>

    <view class="metric-card students">
      <view class="metric-label">在校学生</view>
      <view class="metric-value">{{stats.StudentCount}}</view>
      <view class="metric-note">Students</view>
    </view>

    <view class="metric-card teachers">
      <view class="metric-label">教职工</view>
      <view class="metric-value">{{stats.TeacherCount}}</view>
      <view class="metric-note">Teachers</view>
    </view>

    <view class="metric-card courses">
      <view class="metric-label">开设课程</view>
      <view class="metric-value">{{stats.CourseCount}}</view>
      <view class="metric-note">Courses</view>
    </view>

    <view class="metric-card classes full">
      <view>
        <view class="metric-label">行政班级</view>
        <view class="metric-note">Classes</view>
      </view>
      <view class="metric-value">{{stats.ClassCount}}</view>
    </view>
  </view>

  <view wx:if="{{!loading && !stats}}" class="empty-state">暂无统计数据</view>

  <view class="refresh-tip">下拉页面可刷新数据</view>
</view>
