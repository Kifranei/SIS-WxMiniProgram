<view class="container" style="padding: 20rpx;">
  <view class="title" style="font-size: 36rpx; font-weight: bold; margin-bottom: 30rpx; text-align: center;">系统运行状态</view>
  
  <view wx:if="{{loading}}" style="text-align: center;">数据加载中...</view>
  
  <view wx:else class="stats-grid" style="display: flex; flex-wrap: wrap; justify-content: space-between;">
    
    <view class="stat-card" style="width: 48%; background: #e3f2fd; padding: 30rpx; border-radius: 15rpx; margin-bottom: 20rpx; box-sizing: border-box;">
        <view style="font-size: 24rpx; color: #1565c0;">注册用户</view>
        <view style="font-size: 48rpx; font-weight: bold; color: #0d47a1;">{{stats.UserCount}}</view>
        <view style="font-size: 20rpx; color: #90caf9;">Total Users</view>
    </view>

    <view class="stat-card" style="width: 48%; background: #e8f5e9; padding: 30rpx; border-radius: 15rpx; margin-bottom: 20rpx; box-sizing: border-box;">
        <view style="font-size: 24rpx; color: #2e7d32;">在校学生</view>
        <view style="font-size: 48rpx; font-weight: bold; color: #1b5e20;">{{stats.StudentCount}}</view>
        <view style="font-size: 20rpx; color: #a5d6a7;">Students</view>
    </view>

    <view class="stat-card" style="width: 48%; background: #fff3e0; padding: 30rpx; border-radius: 15rpx; margin-bottom: 20rpx; box-sizing: border-box;">
        <view style="font-size: 24rpx; color: #ef6c00;">教职工</view>
        <view style="font-size: 48rpx; font-weight: bold; color: #e65100;">{{stats.TeacherCount}}</view>
        <view style="font-size: 20rpx; color: #ffcc80;">Teachers</view>
    </view>

    <view class="stat-card" style="width: 48%; background: #f3e5f5; padding: 30rpx; border-radius: 15rpx; margin-bottom: 20rpx; box-sizing: border-box;">
        <view style="font-size: 24rpx; color: #7b1fa2;">开设课程</view>
        <view style="font-size: 48rpx; font-weight: bold; color: #4a148c;">{{stats.CourseCount}}</view>
        <view style="font-size: 20rpx; color: #ce93d8;">Courses</view>
    </view>
    
     <view class="stat-card" style="width: 100%; background: #f5f5f5; padding: 30rpx; border-radius: 15rpx; margin-bottom: 20rpx; box-sizing: border-box; display: flex; justify-content: space-between; align-items: center;">
        <view>
            <view style="font-size: 24rpx; color: #616161;">行政班级</view>
            <view style="font-size: 20rpx; color: #bdbdbd;">Classes</view>
        </view>
        <view style="font-size: 48rpx; font-weight: bold; color: #424242;">{{stats.ClassCount}}</view>
    </view>

  </view>
  
  <view style="margin-top: 40rpx; text-align: center; font-size: 24rpx; color: #ccc;">
    下拉页面可刷新数据
  </view>
</view>