<view class="app-page">
  <view class="hero-card">
    <view class="hero-kicker">Grade Entry</view>
    <view class="hero-title">{{courseName || '成绩录入'}}</view>
    <view class="hero-subtitle">
      <text wx:if="{{courseTypeText}}">{{courseTypeText}}</text>
      <text wx:if="{{courseTypeText && teacherName}}" class="hero-divider">·</text>
      <text wx:if="{{teacherName}}">{{teacherName}}</text>
      <text wx:if="{{(courseTypeText || teacherName) && credits}}" class="hero-divider">·</text>
      <text wx:if="{{credits}}">{{credits}} 学分</text>
    </view>

    <view wx:if="{{!loading && !loadError}}" class="stat-row">
      <view class="stat-chip">
        <text class="stat-label">学生人数</text>
        <text class="stat-value">{{studentCount}}</text>
      </view>
      <view class="stat-chip">
        <text class="stat-label">已录成绩</text>
        <text class="stat-value success">{{gradedCount}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading-panel">正在加载学生名单...</view>
  <view wx:if="{{!loading && loadError}}" class="error-panel">{{loadError}}</view>

  <view wx:if="{{!loading && !loadError && students.length > 0}}" class="section-card">
    <view class="section-header">
      <view>
        <view class="section-title">学生成绩</view>
        <view class="section-desc">留空表示暂未录入，输入后统一保存。</view>
      </view>
      <view class="badge-pill">{{studentCount}} 人</view>
    </view>

    <view class="data-list">
      <block wx:for="{{students}}" wx:key="StudentID">
        <view class="data-item grade-item">
          <view class="data-item-header">
            <view>
              <view class="data-item-title">{{item.StudentName}}</view>
              <view class="data-item-subtitle">{{item.StudentID}}{{item.ClassName ? (' · ' + item.ClassName) : ''}}</view>
            </view>
            <view class="badge-pill {{item.StatusClass}}">
              {{item.StatusText}}
            </view>
          </view>

          <view class="grade-input-row">
            <input
              class="grade-input"
              type="digit"
              placeholder="输入 0-100，留空表示暂无成绩"
              value="{{item.GradeInput}}"
              data-index="{{index}}"
              bindinput="onGradeInput"
            />
            <button class="clear-btn" size="mini" data-index="{{index}}" bindtap="clearGrade">清空</button>
          </view>
        </view>
      </block>
    </view>

    <button class="action-btn primary" loading="{{saving}}" bindtap="saveGrades">保存全部成绩</button>
  </view>

  <view wx:if="{{!loading && !loadError && students.length === 0}}" class="empty-state">
    当前课程暂无选课学生
  </view>
</view>
