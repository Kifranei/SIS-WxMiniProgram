.grade-item {
  border-left: 8rpx solid #0a84ff;
}

.grade-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 22rpx;
}

.grade-input {
  flex: 1;
  height: 80rpx;
  padding: 0 24rpx;
  border-radius: 22rpx;
  background: #fff;
  box-shadow: inset 0 0 0 1rpx rgba(148, 163, 184, 0.26);
  font-size: 28rpx;
  color: #0f172a;
}

.clear-btn {
  margin: 0;
  min-width: 132rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #475467;
  background: linear-gradient(180deg, #fff 0%, #f4f6fb 100%);
  border: 1rpx solid rgba(148, 163, 184, 0.34);
}

.clear-btn::after {
  border: none;
}
