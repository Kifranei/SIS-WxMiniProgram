/* pages/index/index.wxss */
.login-page {
  min-height: 100vh;
  padding: 34rpx 28rpx 40rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 50% -8%, rgba(52, 130, 255, 0.18), transparent 42%),
    linear-gradient(180deg, #ffffff 0%, #f7f7f7 44%, #f0f0f0 100%);
}

.login-shell {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.brand-panel {
  padding: 22rpx 18rpx 12rpx;
  text-align: center;
}

.app-mark {
  width: 118rpx;
  height: 118rpx;
  margin: 0 auto 22rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #5d9bff 0%, #3482ff 100%);
  box-shadow: 0 22rpx 42rpx rgba(52, 130, 255, 0.26);
  overflow: hidden;
}

.app-mark image {
  width: 86rpx;
  height: 86rpx;
  display: block;
}

.app-mark-core {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  background: rgba(255, 255, 255, 0.16);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.24);
}

.brand-title {
  font-size: 42rpx;
  line-height: 1.18;
  font-weight: 700;
  color: #000000;
}

.brand-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8c93b0;
}

.login-form {
  padding: 30rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 44rpx rgba(0, 0, 0, 0.08);
}

.form-title {
  font-size: 34rpx;
  line-height: 1.25;
  font-weight: 700;
  color: #000000;
}

.form-desc {
  margin-top: 8rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: #8c93b0;
}

.field-group {
  margin-top: 24rpx;
}

.field-label {
  margin: 0 0 12rpx 6rpx;
  font-size: 24rpx;
  color: #666666;
}

.input-shell {
  height: 84rpx;
  padding: 0 22rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: #f0f0f0;
  box-shadow: inset 0 0 0 1rpx #e6e6e6;
}

.input-icon {
  width: 42rpx;
  height: 42rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 600;
  color: #3482ff;
  background: #eaf2ff;
}

.input-item {
  flex: 1;
  height: 84rpx;
  font-size: 28rpx;
  color: #000000;
}

.login-btn {
  margin-top: 30rpx;
  height: 84rpx;
  line-height: 84rpx;
  padding: 0;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
  background: #3482ff;
  box-shadow: 0 18rpx 34rpx rgba(52, 130, 255, 0.26);
}

.login-btn[disabled] {
  color: rgba(255, 255, 255, 0.8);
  background: #c2d9ff;
  box-shadow: none;
}

.login-btn::after {
  border: none;
}

.error-message {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #410002;
  background: #fdf6f4;
  box-shadow: inset 0 0 0 1rpx rgba(233, 70, 52, 0.18);
}

@media (min-width: 768px) {
  .login-shell {
    max-width: 760rpx;
    margin: 0 auto;
  }
}
