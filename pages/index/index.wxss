/* pages/index/index.wxss */
.login-page {
  position: relative;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx 28rpx;
  box-sizing: border-box;
  overflow: hidden;
  background:
    radial-gradient(circle at 10% 12%, rgba(56, 189, 248, 0.32), transparent 26%),
    radial-gradient(circle at 88% 14%, rgba(251, 191, 36, 0.28), transparent 24%),
    radial-gradient(circle at 50% 100%, rgba(125, 211, 252, 0.16), transparent 34%),
    linear-gradient(180deg, #edf6ff 0%, #eef2f7 48%, #f7f8fb 100%);
}

.ambient {
  position: absolute;
  border-radius: 999rpx;
  filter: blur(20rpx);
  opacity: 0.5;
}

.ambient-left {
  top: 120rpx;
  left: -80rpx;
  width: 280rpx;
  height: 280rpx;
  background: rgba(14, 165, 233, 0.2);
}

.ambient-right {
  right: -90rpx;
  bottom: 200rpx;
  width: 320rpx;
  height: 320rpx;
  background: rgba(245, 158, 11, 0.18);
}

.login-shell {
  position: relative;
  z-index: 1;
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.brand-card,
.login-form {
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.84);
  box-shadow: 0 24rpx 60rpx rgba(15, 23, 42, 0.1);
  backdrop-filter: blur(20rpx);
}

.brand-card {
  padding: 34rpx 30rpx;
}

.brand-kicker,
.form-kicker {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  color: #8c93a3;
}

.brand-title {
  margin-top: 10rpx;
  font-size: 52rpx;
  line-height: 1.18;
  font-weight: 700;
  color: #0f172a;
}

.brand-title.accent {
  color: #0284c7;
}

.brand-desc,
.form-desc {
  margin-top: 18rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #667085;
}

.brand-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 26rpx;
}

.brand-tag {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #0f766e;
  background: rgba(20, 184, 166, 0.12);
}

.login-form {
  padding: 34rpx 30rpx;
}

.form-title {
  margin-top: 10rpx;
  font-size: 48rpx;
  font-weight: 700;
  color: #111827;
}

.field-group {
  margin-top: 22rpx;
}

.field-label {
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: #475467;
}

.input-item {
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: inset 0 0 0 1rpx rgba(148, 163, 184, 0.28);
  font-size: 28rpx;
  color: #0f172a;
}

.login-btn {
  margin-top: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 86rpx;
  line-height: 86rpx;
  padding: 0;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, #0a84ff 0%, #38bdf8 100%);
  box-shadow: 0 18rpx 36rpx rgba(10, 132, 255, 0.24);
}

.login-btn[disabled] {
  opacity: 0.78;
}

.login-btn::after {
  border: none;
}

.error-message {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #b42318;
  background: rgba(254, 242, 242, 0.96);
  box-shadow: inset 0 0 0 1rpx rgba(248, 113, 113, 0.18);
}

.hint-card {
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  border-radius: 28rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
  box-shadow: inset 0 0 0 1rpx rgba(148, 163, 184, 0.14);
}

.hint-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #0f172a;
}

.hint-text {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #667085;
}

@media (min-width: 768px) {
  .login-shell {
    max-width: 880rpx;
    gap: 28rpx;
  }
}
