<view class="login-page">
  <view class="login-shell">
    <view class="brand-panel">
      <view class="app-mark">
        <image src="/logo.svg" mode="aspectFit"></image>
      </view>
      <view class="brand-title">教学管理信息系统</view>
      <view class="brand-desc">移动端教务入口</view>
    </view>

    <view class="login-form">
      <view class="form-title">账号登录</view>
      <view class="form-desc">请使用教务系统账号和密码登录。</view>

      <view class="field-group">
        <view class="field-label">用户名</view>
        <view class="input-shell">
          <input class="input-item" placeholder="请输入用户名" bindinput="onUsernameInput" />
        </view>
      </view>

      <view class="field-group">
        <view class="field-label">密码</view>
        <view class="input-shell">
          <input class="input-item" placeholder="请输入密码" password="true" bindinput="onPasswordInput" />
        </view>
      </view>

      <button class="login-btn" loading="{{submitting}}" disabled="{{submitting}}" bindtap="onLoginTap">
        {{submitting ? '正在登录...' : '登录'}}
      </button>

      <view wx:if="{{errorMessage}}" class="error-message">{{errorMessage}}</view>
    </view>
  </view>
</view>
