<view class="app-page">
  <view class="hero-card">
    <view class="hero-kicker">Academic Report</view>
    <view class="hero-title">我的成绩单</view>
    <view class="hero-subtitle">查看当前账号已公布的课程成绩与学分信息。</view>
  </view>

  <view wx:if="{{loading}}" class="loading-panel">正在加载成绩数据...</view>

  <view wx:if="{{!loading && gradeList.length > 0}}" class="section-card">
    <view class="section-header">
      <view>
        <view class="section-title">成绩列表</view>
        <view class="section-desc">所有已同步到移动端的课程成绩</view>
      </view>
      <view class="badge-pill success">{{gradeList.length}} 门</view>
    </view>

    <view class="data-list">
      <block wx:for="{{gradeList}}" wx:key="index">
        <view class="data-item">
          <view class="data-item-header">
            <view>
              <view class="data-item-title">{{item.CourseName}}</view>
              <view class="data-item-subtitle">学分：{{item.Credits}}</view>
            </view>
            <view class="data-item-value grade-value {{item.Grade >= 60 ? 'success' : 'danger'}}">{{item.Grade}}</view>
          </view>
        </view>
      </block>
    </view>
  </view>

  <view wx:if="{{!loading && gradeList.length === 0}}" class="empty-state">
    暂无成绩记录
  </view>
</view>
